{
  "name": "musicvideobot",
  "private": true,
  "version": "0.1.0",
  "description": "Discord music bot with voice playback, queues, and music-video embeds",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:bot": "npm run dev -w @musicvideobot/bot",
    "deploy:commands": "npm run deploy:commands -w @musicvideobot/bot",
    "deploy:commands:global": "npm run deploy:commands:global -w @musicvideobot/bot",
    "build": "npm run build -w @musicvideobot/bot",
    "typecheck": "npm run typecheck -w @musicvideobot/bot"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "allowScripts": {
    "@discordjs/opus@0.10.0": true,
    "esbuild@0.28.2": true,
    "ffmpeg-static@5.3.0": true
  }
}
