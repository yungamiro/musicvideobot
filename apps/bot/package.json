{
  "name": "@musicvideobot/bot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "deploy:commands": "tsx src/deployCommands.ts",
    "deploy:commands:global": "tsx src/deployGlobalCommands.ts"
  },
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.19.2",
    "@distube/youtube": "^1.0.4",
    "discord.js": "^14.27.0",
    "distube": "^5.2.3",
    "dotenv": "^17.2.2",
    "ffmpeg-static": "^5.3.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "5.6.3"
  }
}
